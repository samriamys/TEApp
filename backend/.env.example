# Local development settings shared by Docker Compose and Spring Boot.
# Compose uses postgres:5432 internally and overrides POSTGRES_HOST/POSTGRES_PORT
# for the backend container. These loopback settings also support a host-run API.
POSTGRES_DB=teapp_db
POSTGRES_USER=teapp
POSTGRES_PASSWORD=replace-with-a-local-dev-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

SERVER_PORT=8080
SERVER_ADDRESS=0.0.0.0
SPRING_JPA_SHOW_SQL=false
FRONTEND_PORT=4200
